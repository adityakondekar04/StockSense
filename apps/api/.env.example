# Neon PostgreSQL pooled connection URL
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection URL for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server configuration
PORT=4000

# Production: comma-separated list of allowed frontend origins (e.g. your Vercel URL)
# Leave empty in dev to allow all origins
CORS_ORIGIN=https://your-app.vercel.app

# JWT signing secret — use a long random string in production
AUTH_SECRET=change-me-to-a-long-random-secret

# AI Configuration (optional — app fully works without this)
LLM_API_KEY=
LLM_PROVIDER=groq
LLM_TIMEOUT_MS=5000
